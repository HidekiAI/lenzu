# Generated by Cargo
# will have compiled files and executables
debug/
target/
target-*/
node_modules/

# electron-builder output (HUD .deb / .AppImage staging)
lenzu_server/dist-deb/

# Leftover from `<appimage> --appimage-extract` inspection
squashfs-root/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# ignore CMake and cargo build dirs, as well as IDE dirs such as .vs and .vscode
out/
build/
.vs/
.vscode/
obj/
.fake/
# i.e. foobar.vcproj.user and foobar.vcxproj.user
*.v*proj.user
*.bak

tags

*png
# Intentional demo and test assets — keep tracked despite the *.png rule above
!assets/OCR-Demo-*.png
!assets/Unit-test-sample-texts.png
!assets/Unit-test-yokogaki.png
!assets/Unit-test-tategaki.png
!assets/Unit-test-tegaki.png
!assets/Screenshot-JP.png
!assets/Screenshot-EN.png
!packaging/lenzu/lenzu.png
!assets/icon.png
!docs/*.png
!prototypes/dbnet-ocr-pipeline/docs/*.png
!prototypes/dbnet-ocr-pipeline/docs/**/*.png

# Large model binaries — download via scripts/setup.sh, never commit
assets/manga-ocr/
assets/manga-ocr-2025/
prototypes/paddleocr-vl-manga/model/

.config/
.local/
build*/

gha-creds-*.json
.ollama_mode

# Auto-generated by `make notices` (cargo-about). Regenerated whenever
# Cargo.lock changes; bundled into the lenzu .deb at build time.
/lenzu/NOTICES.crates.md

# Models (Heavy binaries) — fetch from HuggingFace, never commit
/models/*.onnx
/models/**/*.onnx
/models/**/*.onnx_data
/models/**/*.json
/models/**/*.jinja
/models/**/tokenizer.model

# Exclude the downloaded ZIPs
*.zip

# LLM crufts
CLAUDE.md
.claude/
.gemini/

