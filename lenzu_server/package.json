{
  "name": "electron-translucent-desktop-overlay",
  "version": "1.0.0",
  "description": "A transparent HUD-like overlay for Linux desktop displaying UDP text as closed-caption/subtitle",
  "main": "src/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "start:x11": "electron --enable-transparent-visuals .",
    "test:send": "node test_sender.js"
  },
  "keywords": [
    "electron",
    "hud",
    "overlay",
    "transparent",
    "udp",
    "subtitles",
    "captions",
    "linux"
  ],
  "author": "Hideki A. Ikeda",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "electron": "^41.1.0",
    "esbuild": "^0.25.0",
    "vitest": "^3.0.0"
  }
}
