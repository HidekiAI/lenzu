{
  "name": "lenzu-hud",
  "version": "1.0.0",
  "description": "A transparent HUD-like overlay for Linux desktop displaying UDP text as closed-caption/subtitle",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "GTK_CSD=0 node_modules/.bin/electron dist/main.js",
    "test:send": "node test_sender.js",
    "deb": "npm run build && electron-builder --linux deb"
  },
  "keywords": [
    "electron",
    "hud",
    "overlay",
    "transparent",
    "udp",
    "subtitles",
    "captions",
    "linux"
  ],
  "author": "Hideki A. Ikeda",
  "license": "MIT",
  "//": "Electron 41.3.0 confirmed working for transparent:true on Linux X11 (re-tested 2026-04-25 against integrated client and standalone HUD demo). The 36-41 transparency regression that previously held us on 35.x has been resolved upstream.",
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"],
    "overrides": {
      "electron": "41.3.0",
      "tar": "^7.5.11",
      "@tootallnate/once": "^3.0.1"
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "electron": "41.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.exactasystems.lenzu.hud",
    "productName": "lenzu-hud",
    "executableName": "lenzu-hud",
    "files": [
      "dist/**/*",
      "hud_config.json",
      "package.json",
      "!dist/hud-set-override-redirect"
    ],
    "extraResources": [
      {
        "from": "dist/hud-set-override-redirect",
        "to": "hud-set-override-redirect"
      }
    ],
    "directories": {
      "output": "dist-deb"
    },
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Utility",
      "synopsis": "Transparent desktop HUD for Lenzu OCR overlay"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libx11-6",
        "xdg-utils",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1",
        "libxcb-dri3-0"
      ]
    }
  }
}
